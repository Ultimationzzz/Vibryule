<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Vibryule</AssemblyName>
    <RootNamespace>OotSceneViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.3.0</Version>
    <ApplicationIcon>assets\vibryule.ico</ApplicationIcon>
    <Authors>Ultimation</Authors>
    <Copyright>Copyright (c) 2026 Ultimation</Copyright>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
    <EmbeddedResource Include="assets\vibryule.ico" LogicalName="Vibryule.AppIcon" />
    <ProjectReference Include="third_party\SpaceUI\SpaceUI.csproj" />
    <PackageReference Include="AstcSharp" Version="3.1.0" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
